---
import Kicker from "../../components/ui/Kicker.astro";
import SourceBadge from "../../components/ui/SourceBadge.astro";
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { annotateGlossaryTerms } from "../../lib/glossary-inline";
import {
  stars as toStars,
  effectSign as toEffectSign,
  effectColorClass,
} from "../../lib/effect-size";
import TableOfContents from "../../components/TableOfContents.astro";
import RelatedStrategyCard from "../../components/RelatedStrategyCard.astro";

export async function getStaticPaths() {
  const strategies = await getCollection("strategies");
  return strategies.map((s) => ({ params: { slug: s.id }, props: { entry: s } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

const allColumns = await getCollection("columns");
const referringColumns = allColumns
  .filter((c) => (c.data.relatedStrategies ?? []).includes(entry.id))
  .sort((a, b) => (b.data.date || "").localeCompare(a.data.date || ""));

const allStrategies = await getCollection("strategies");
const forwardIds = d.relatedStrategies ?? [];
const backwardIds = allStrategies
  .filter((s) => (s.data.relatedStrategies ?? []).includes(entry.id))
  .map((s) => s.id);
const relatedStrategyEntries = [...new Set([...forwardIds, ...backwardIds])]
  .filter((id) => id !== entry.id)
  .map((id) => allStrategies.find((s) => s.id === id))
  .filter((s): s is (typeof allStrategies)[number] => s !== undefined);

const siteUrl = "https://edu-evidence.org";
const pageUrl = `${siteUrl}/strategies/${entry.id}`;
const dateModified = d.lastVerified ?? "2026-04-01";
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: d.title,
  description: d.summary,
  datePublished: dateModified,
  dateModified,
  author: {
    "@type": "Person",
    name: "Isagawa Hayato",
    url: `${siteUrl}/about`,
    sameAs: ["https://github.com/Hayato-Isagawa"],
  },
  publisher: {
    "@type": "Organization",
    name: "EduEvidence JP",
    url: siteUrl,
    logo: `${siteUrl}/logo.svg`,
    sameAs: ["https://x.com/edu_evidence_jp"],
  },
  image: `${siteUrl}/og/${entry.id}.png`,
  mainEntityOfPage: pageUrl,
  url: pageUrl,
  inLanguage: "ja",
  keywords: d.tags.join(", "),
  ...(d.sourceUrl && {
    isBasedOn: {
      "@type": "CreativeWork",
      url: d.sourceUrl,
      ...(d.sourceTitle && { name: d.sourceTitle }),
    },
  }),
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ホーム", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "指導法一覧", item: `${siteUrl}/#strategy-list` },
    { "@type": "ListItem", position: 3, name: d.title, item: pageUrl },
  ],
};

const stars = toStars(d.evidenceStrength);
const yen = "¥".repeat(d.cost) + "·".repeat(5 - d.cost);

const effectSign = toEffectSign(d.monthsGained);
const effectColor = effectColorClass(d.monthsGained);
const effectNote =
  d.monthsGained > 0
    ? `3月時点で、通常より約${d.monthsGained}ヶ月先の学力水準に到達`
    : d.monthsGained === 0
      ? "学力への効果は確認されていない"
      : `3月時点で、通常より約${Math.abs(d.monthsGained)}ヶ月分学力が低下する傾向`;
---

<Layout
  title={`${d.title} — EduEvidence JP`}
  description={d.summary}
  ogImagePath={`/og/${entry.id}.png`}
  ogVersion={entry.data.lastVerified?.replaceAll("-", "")}
  articleJsonLd={articleJsonLd}
  breadcrumbJsonLd={breadcrumbJsonLd}
  longForm
>
  <div class="pt-10 pb-6">
    <a
      href="/"
      class="font-mono text-xs uppercase tracking-widest text-sub hover:text-ink"
    >
      ← 指導法一覧へ戻る
    </a>
  </div>

  <header class="grid grid-cols-12 gap-6 pb-12 border-b border-line">
    <div class="col-span-12 md:col-span-8 space-y-6">
      <div class="space-y-1">
        <div class="flex items-center gap-3">
          <Kicker class="leading-none">
            Strategy{d.lastVerified ? ` — 最終確認 ${d.lastVerified}` : ""}
          </Kicker>
          <SourceBadge evidence={d.evidence} variant="full" />
        </div>
        <p class="text-xs text-sub">指導法</p>
      </div>
      <h1
        class="font-black text-3xl sm:text-4xl md:text-5xl lg:text-6xl leading-[1.15] tracking-tight"
      >
        {d.title}
      </h1>
      <p
        class="text-sub text-base md:text-lg leading-loose max-w-2xl"
      >
        {d.summary}
      </p>
      {
        d.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 pt-2">
            {d.tags.map((tag) => (
              <a
                href={`/tags/${encodeURIComponent(tag)}`}
                class="font-mono text-[11px] uppercase tracking-widest text-sub border border-line rounded-full px-3 py-1 hover:border-accent hover:text-accent motion-safe:transition-colors motion-safe:duration-200 motion-safe:ease-out"
              >
                {tag}
              </a>
            ))}
          </div>
        )
      }
    </div>

    <div
      class="col-span-12 md:col-span-4 md:pt-2 grid grid-cols-2 md:grid-cols-1 gap-y-6 gap-x-4 font-mono text-xs"
    >
      <div class="space-y-1">
        <div class="uppercase tracking-widest text-sub">
          学習効果
        </div>
        <div
          class={`text-4xl font-black tabular-nums ${effectColor}`}
        >
          {effectSign}{d.monthsGained}<span class="text-base ml-1">ヶ月</span>
        </div>
        <div class="normal-case tracking-normal text-sub leading-snug">
          {effectNote}
        </div>
      </div>
      <div class="space-y-1">
        <div class="uppercase tracking-widest text-sub">
          エビデンス
        </div>
        <div class="text-rating text-base">{stars}</div>
      </div>
      <div class="space-y-1">
        <div class="uppercase tracking-widest text-sub">
          コスト
        </div>
        <div class="text-accent text-base tracking-widest">
          {yen}
        </div>
      </div>
      <div class="space-y-1">
        <div class="uppercase tracking-widest text-sub">
          対象
        </div>
        <div class="text-ink leading-relaxed">
          {d.subjects.join(" · ")}<br />{d.grades.join(" · ")}
        </div>
      </div>
    </div>
  </header>

  {
    (d.evidence?.eef || d.evidence?.japan || d.evidence?.hattie || d.culturalContext || d.methodology) && (
      <section class="pt-12 max-w-2xl space-y-6">
        <div class="space-y-1">
          <Kicker as="div">
            Evidence Breakdown
          </Kicker>
          <h2 class="text-2xl font-black tracking-tight">出典別のエビデンス</h2>
        </div>

        <div class="space-y-4">
          {d.evidence?.eef && (
            <div class="border border-source-eef/40 rounded-xl p-5 space-y-2">
              <div class="flex items-baseline gap-3">
                <span class="font-mono text-xs uppercase tracking-widest text-source-eef">EEF Toolkit</span>
                {d.evidence.eef.monthsGained !== undefined && (
                  <span class="font-black text-xl text-source-eef tabular-nums">
                    {d.evidence.eef.monthsGained > 0 ? "+" : ""}
                    {d.evidence.eef.monthsGained}
                    <span class="text-xs font-sans ml-1">ヶ月</span>
                  </span>
                )}
                {d.evidence.eef.strength !== undefined && (
                  <span class="text-rating text-sm">
                    {"★".repeat(d.evidence.eef.strength)}
                    {"☆".repeat(5 - d.evidence.eef.strength)}
                  </span>
                )}
              </div>
              {d.evidence.eef.note && (
                <p class="text-sm text-sub leading-relaxed" set:html={annotateGlossaryTerms(d.evidence.eef.note)} />
              )}
            </div>
          )}

          {d.evidence?.japan && (
            <div class="border border-source-japan/40 rounded-xl p-5 space-y-2">
              <div class="flex items-baseline gap-3 flex-wrap">
                <span class="font-mono text-xs uppercase tracking-widest text-source-japan">日本研究</span>
                {d.evidence.japan.monthsGained !== undefined && (
                  <span class="font-black text-xl text-source-japan tabular-nums">
                    {d.evidence.japan.monthsGained > 0 ? "+" : ""}
                    {d.evidence.japan.monthsGained}
                    <span class="text-xs font-sans ml-1">ヶ月</span>
                  </span>
                )}
                {d.evidence.japan.strength !== undefined && (
                  <span class="text-rating text-sm">
                    {"★".repeat(d.evidence.japan.strength)}
                    {"☆".repeat(5 - d.evidence.japan.strength)}
                  </span>
                )}
                {d.evidence.japan.researcher && (
                  <span class="text-xs text-sub">{d.evidence.japan.researcher}</span>
                )}
              </div>
              {d.evidence.japan.note && (
                <p class="text-sm text-sub leading-relaxed" set:html={annotateGlossaryTerms(d.evidence.japan.note)} />
              )}
            </div>
          )}

          {d.evidence?.hattie && (
            <div class="border border-line rounded-xl p-5 space-y-2 bg-source-hattie-bg/30 dark:bg-source-hattie/5">
              <div class="flex items-baseline gap-3 flex-wrap">
                <span class="font-mono text-xs uppercase tracking-widest text-source-hattie">Hattie (Visible Learning)</span>
                {d.evidence.hattie.cohensD !== undefined && (
                  <span class="font-black text-xl text-source-hattie tabular-nums">
                    d = {d.evidence.hattie.cohensD.toFixed(2)}
                  </span>
                )}
              </div>
              <p class="text-xs text-sub leading-relaxed">
                Hattie の効果量は他のメタ分析と比べて楽観的な傾向があり、再現性に疑問が示されている場合があります。参考値としてお読みください。詳しくは <a href="/guide/cultural-context" class="link-underline text-accent">エビデンスの文脈</a> を参照。
              </p>
              {d.evidence.hattie.note && (
                <p class="text-sm text-sub leading-relaxed" set:html={annotateGlossaryTerms(d.evidence.hattie.note)} />
              )}
            </div>
          )}
        </div>

        {d.methodology && (
          <div class="border border-line rounded-xl p-5 space-y-3 bg-card">
            <div class="flex items-baseline gap-3">
              <Kicker as="span" tone="sub">Technical Appendix</Kicker>
              <span class="text-xs text-sub">研究の詳細</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
              {d.methodology.studies !== undefined && (
                <div class="space-y-1">
                  <div class="text-xs text-sub">研究数</div>
                  <div class="font-black text-lg tabular-nums">{d.methodology.studies} 件</div>
                </div>
              )}
              {d.methodology.sampleSize && (
                <div class="space-y-1">
                  <div class="text-xs text-sub">総サンプルサイズ</div>
                  <div class="font-black text-lg tabular-nums">{d.methodology.sampleSize}</div>
                </div>
              )}
              {d.methodology.effectSize && (
                <div class="space-y-1 sm:col-span-2">
                  <div class="text-xs text-sub">効果量</div>
                  <div class="font-mono text-sm">{d.methodology.effectSize}</div>
                </div>
              )}
            </div>
            {d.methodology.primaryEvidenceReview && (
              <div class="space-y-1 border-t border-line pt-3">
                <div class="text-xs text-sub">主要エビデンスレビュー</div>
                <div class="text-sm">
                  {d.methodology.primaryEvidenceReview.authors} ({d.methodology.primaryEvidenceReview.year}).{" "}
                  {d.methodology.primaryEvidenceReview.url ? (
                    <a href={d.methodology.primaryEvidenceReview.url} target="_blank" rel="noopener" class="link-underline text-accent">
                      {d.methodology.primaryEvidenceReview.title}
                    </a>
                  ) : (
                    <span>{d.methodology.primaryEvidenceReview.title}</span>
                  )}
                </div>
              </div>
            )}
            {d.methodology.limitations && (
              <div class="space-y-1 border-t border-line pt-3">
                <div class="text-xs text-sub">エビデンスの限界</div>
                <p class="text-sm text-sub leading-relaxed" set:html={annotateGlossaryTerms(d.methodology.limitations)} />
              </div>
            )}
          </div>
        )}

        {d.culturalContext && (
          <div class="border-l-4 border-accent pl-5 py-1 space-y-2">
            <Kicker as="div">
              日本の文脈で考慮したいこと
            </Kicker>
            <p class="text-sm leading-loose" set:html={annotateGlossaryTerms(d.culturalContext)} />
            <p class="text-xs text-sub">
              なぜこの注記があるか:<a href="/guide/cultural-context" class="link-underline text-accent ml-1">エビデンスと文化的文脈</a>
            </p>
          </div>
        )}
      </section>
    )
  }

  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_220px] lg:gap-10">
    <div class="min-w-0">
      <article class="prose-article py-16 max-w-2xl">
        <TableOfContents headings={headings} variant="mobile" />
        <Content />
      </article>
    </div>
    <aside class="lg:pt-16">
      <TableOfContents headings={headings} variant="sidebar" />
    </aside>
  </div>

  {
    (d.sourceUrl || d.sourceTitle) && (
      <section class="pt-8 border-t border-line max-w-2xl space-y-2">
        <div class="text-xs text-sub">
          参考にしている情報源
        </div>
        {d.sourceUrl ? (
          <a
            class="link-underline text-ink hover:text-accent"
            href={d.sourceUrl}
            target="_blank"
            rel="noopener"
          >
            {d.sourceTitle ?? d.sourceUrl}
          </a>
        ) : (
          <p class="text-ink">{d.sourceTitle}</p>
        )}
      </section>
    )
  }

  {
    relatedStrategyEntries.length > 0 && (
      <section class="pt-10 mt-10 border-t border-line max-w-2xl space-y-6">
        <div class="space-y-1">
          <Kicker as="div">
            Related Strategies
          </Kicker>
          <h2 class="text-2xl font-black tracking-tight">関連する指導法</h2>
          <p class="text-sm text-sub">
            この指導法とあわせて検討したい、関連する指導法です。
          </p>
        </div>
        <ul class="space-y-3">
          {relatedStrategyEntries.map((s) => (
            <li>
              <RelatedStrategyCard
                href={`/strategies/${s.id}`}
                title={s.data.title}
                summary={s.data.summary}
                monthsGained={s.data.monthsGained}
                evidenceStrength={s.data.evidenceStrength}
                evidence={s.data.evidence}
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    referringColumns.length > 0 && (
      <section class="pt-10 mt-10 border-t border-line max-w-2xl space-y-6">
        <div class="space-y-1">
          <Kicker as="div">
            Mentioned in Columns
          </Kicker>
          <h2 class="text-2xl font-black tracking-tight">この指導法を扱っているコラム</h2>
          <p class="text-sm text-sub">
            本指導法を論点として取り上げたコラム。現場の文脈や政策との関係を読むことができます。
          </p>
        </div>
        <ul class="space-y-3">
          {referringColumns.map((c) => (
            <li>
              <a
                href={`/columns/${c.id}`}
                class="group block border border-line rounded-xl p-4 hover:border-accent hover:bg-card motion-safe:transition-colors motion-safe:duration-200 motion-safe:ease-out"
              >
                <div class="flex items-start justify-between gap-4">
                  <div class="flex-1 min-w-0 space-y-1">
                    <h3 class="text-base md:text-lg font-black tracking-tight leading-snug group-hover:text-accent motion-safe:transition">
                      {c.data.title}
                    </h3>
                    <p class="text-sm text-sub leading-relaxed line-clamp-2">
                      {c.data.summary}
                    </p>
                    <Kicker as="div" tone="sub" size="2xs">
                      {c.data.date}
                    </Kicker>
                  </div>
                  <span class="shrink-0 text-sub motion-safe:transition group-hover:translate-x-1">→</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>
