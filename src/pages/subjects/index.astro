---
import PageHero from "../../components/blocks/PageHero.astro";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const strategies = await getCollection("strategies");

const subjectMap = new Map<string, number>();
for (const s of strategies) {
  for (const subj of s.data.subjects) {
    subjectMap.set(subj, (subjectMap.get(subj) ?? 0) + 1);
  }
}

const subjects = [...subjectMap.entries()].sort((a, b) => b[1] - a[1]);
---

<Layout title="教科から探す — EduEvidence JP">
  <PageHero kicker="Browse by subject">
    <Fragment slot="title">教科から探す</Fragment>
      <p>担当する教科に関連する指導法を見つけられます。</p>
  </PageHero>

  <section class="pb-24">
    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
      {
        subjects.map(([subj, count]) => (
          <a
            href={`/subjects/${encodeURIComponent(subj)}`}
            class="group block border border-line rounded-xl p-6 hover:border-accent hover:bg-card space-y-2 motion-safe:transition-colors motion-safe:duration-200 motion-safe:ease-out"
          >
            <div class="text-2xl font-black group-hover:text-accent motion-safe:transition">
              {subj}
            </div>
            <div class="text-xs text-sub">
              {count}件の指導法 →
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
