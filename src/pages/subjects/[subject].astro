---
import { getCollection } from "astro:content";
import FacetStrategyPage from "../../components/FacetStrategyPage.astro";

export async function getStaticPaths() {
  const strategies = await getCollection("strategies");
  const subjectSet = new Set<string>();
  for (const s of strategies) {
    for (const subj of s.data.subjects) subjectSet.add(subj);
  }
  return [...subjectSet].map((subject) => ({
    params: { subject },
    props: { subject },
  }));
}

const { subject } = Astro.props;
const allStrategies = await getCollection("strategies");
const strategies = allStrategies
  .filter((s) => s.data.subjects.includes(subject))
  .sort((a, b) => b.data.monthsGained - a.data.monthsGained);
---

<FacetStrategyPage kind="subject" value={subject} strategies={strategies} />
