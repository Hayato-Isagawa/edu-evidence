---
import Kicker from "../../components/ui/Kicker.astro";
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import RelatedStrategyCard from "../../components/RelatedStrategyCard.astro";
import TableOfContents from "../../components/TableOfContents.astro";

export async function getStaticPaths() {
  const columns = await getCollection("columns");
  return columns.map((c) => ({ params: { slug: c.id }, props: { entry: c } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

const dayFormatter = new Intl.DateTimeFormat("ja-JP", {
  year: "numeric",
  month: "long",
  day: "numeric",
  weekday: "short",
  timeZone: "Asia/Tokyo",
});
function formatDay(iso: string): string {
  return dayFormatter.format(new Date(`${iso}T00:00:00+09:00`));
}

const allStrategies = await getCollection("strategies");
const strategyById = new Map(allStrategies.map((s) => [s.id, s]));
const related = (d.relatedStrategies ?? [])
  .map((id) => strategyById.get(id))
  .filter((s): s is (typeof allStrategies)[number] => Boolean(s));

// 出典の最終確認日は、公開日と違うときだけ並べて出す。
// boolean ではなく値を保持する — boolean だとテンプレート側で
// d.lastVerified の undefined が絞り込まれず formatDay に渡せない。
const lastVerified =
  d.lastVerified && d.lastVerified !== d.date ? d.lastVerified : null;

const allColumns = await getCollection("columns");
const seriesItems = d.series
  ? allColumns
      .filter((c) => c.data.series?.id === d.series!.id)
      .sort((a, b) => (a.data.series!.order ?? 0) - (b.data.series!.order ?? 0))
  : [];
const seriesTitle = seriesItems.find((c) => c.data.series?.title)?.data.series?.title;
const currentIndex = seriesItems.findIndex((c) => c.id === entry.id);

const siteUrl = "https://edu-evidence.org";
const pageUrl = `${siteUrl}/columns/${entry.id}`;
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: d.title,
  description: d.summary,
  datePublished: d.date,
  dateModified: d.lastVerified ?? d.date,
  author: {
    "@type": "Person",
    name: "Isagawa Hayato",
    url: `${siteUrl}/about`,
    sameAs: ["https://github.com/Hayato-Isagawa"],
  },
  publisher: {
    "@type": "Organization",
    name: "EduEvidence JP",
    url: siteUrl,
    logo: `${siteUrl}/logo.svg`,
    sameAs: ["https://x.com/edu_evidence_jp"],
  },
  mainEntityOfPage: pageUrl,
  url: pageUrl,
  inLanguage: "ja",
  keywords: d.tags.join(", "),
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ホーム", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "コラム", item: `${siteUrl}/columns` },
    { "@type": "ListItem", position: 3, name: d.title, item: pageUrl },
  ],
};
---

<Layout
  title={`${d.title} — EduEvidence JP`}
  description={d.summary}
  articleJsonLd={articleJsonLd}
  breadcrumbJsonLd={breadcrumbJsonLd}
  longForm
>
  <header class="pt-10 sm:pt-14 md:pt-20 lg:pt-28 pb-12 border-b border-line">
    <Kicker>
      Column
    </Kicker>
    <h1
      class="mt-5 font-black text-3xl sm:text-4xl md:text-5xl lg:text-6xl leading-[1.15] tracking-tight"
    >
      {d.title}
    </h1>
    <p class="mt-3 text-sm text-sub font-mono tracking-wide">
      {/* 余白は先頭側に持たせる。2 行に折り返したとき、後続ブロックの左端を
          公開日と揃えるため(ml- を後続に付けるとぶら下がりインデントになる)。
          inline-block はフレーズ途中で折れないようにするためのもの。 */}
      <time datetime={d.date} class:list={[lastVerified && "mr-3"]}>
        公開: {formatDay(d.date)}
      </time>
      {lastVerified && (
        <span class="inline-block">
          <time datetime={lastVerified}>出典の最終確認: {formatDay(lastVerified)}</time>
        </span>
      )}
    </p>
    <p
      class="mt-6 text-sub text-base md:text-lg leading-loose max-w-2xl"
    >
      {d.summary}
    </p>
    {
      d.tags.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {d.tags.map((tag) => (
            <a
              href={`/tags/${encodeURIComponent(tag)}`}
              class="font-mono text-[11px] uppercase tracking-widest text-sub border border-line rounded-full px-3 py-1 hover:border-accent hover:text-accent motion-safe:transition-colors motion-safe:duration-200 motion-safe:ease-out"
            >
              {tag}
            </a>
          ))}
        </div>
      )
    }
    <p class="mt-6 text-sub text-sm leading-relaxed">
      <a href="/columns" class="link-underline">← コラム一覧</a>
      <span class="ml-3"><a href="/" class="link-underline">トップ</a></span>
    </p>
  </header>

  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_220px] lg:gap-10">
    <div class="min-w-0">
      <article class="prose-article py-16 max-w-2xl">
        <TableOfContents headings={headings} variant="mobile" />
        <Content />
      </article>
    </div>
    <aside class="lg:pt-16">
      <TableOfContents headings={headings} variant="sidebar" />
    </aside>
  </div>

  {
    seriesItems.length >= 2 && (
      <section class="pt-10 border-t border-line max-w-2xl space-y-6">
        <div class="space-y-1">
          <Kicker as="div">
            Series
          </Kicker>
          <h2 class="text-2xl font-black tracking-tight">シリーズ: {seriesTitle}</h2>
          <p class="text-sm text-sub">
            全{seriesItems.length}回シリーズの第{currentIndex + 1}回です。
          </p>
        </div>
        <ol class="space-y-3">
          {seriesItems.map((c, i) =>
            c.id === entry.id ? (
              <li>
                <div class="block border border-accent rounded-xl p-4 bg-card">
                  <div class="space-y-1">
                    <Kicker as="div" size="2xs">
                      第{i + 1}回 ・ この記事
                    </Kicker>
                    <h3 class="text-base md:text-lg font-black tracking-tight leading-snug">
                      {c.data.title}
                    </h3>
                    <p class="text-sm text-sub leading-relaxed line-clamp-2">
                      {c.data.summary}
                    </p>
                  </div>
                </div>
              </li>
            ) : (
              <li>
                <a
                  href={`/columns/${c.id}`}
                  class="group block border border-line rounded-xl p-4 hover:border-accent hover:bg-card motion-safe:transition-colors motion-safe:duration-200 motion-safe:ease-out"
                >
                  <div class="flex items-start justify-between gap-4">
                    <div class="flex-1 min-w-0 space-y-1">
                      <Kicker as="div" tone="sub" size="2xs">
                        第{i + 1}回
                      </Kicker>
                      <h3 class="text-base md:text-lg font-black tracking-tight leading-snug group-hover:text-accent motion-safe:transition">
                        {c.data.title}
                      </h3>
                      <p class="text-sm text-sub leading-relaxed line-clamp-2">
                        {c.data.summary}
                      </p>
                    </div>
                    <span class="shrink-0 text-sub motion-safe:transition group-hover:translate-x-1">
                      →
                    </span>
                  </div>
                </a>
              </li>
            )
          )}
        </ol>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="pt-10 border-t border-line max-w-2xl space-y-6">
        <div class="space-y-1">
          <Kicker as="div">
            Related Strategies
          </Kicker>
          <h2 class="text-2xl font-black tracking-tight">関連する指導法</h2>
          <p class="text-sm text-sub">
            本コラムで言及した指導法の詳細ページ。エビデンスの強さと効果量を確認できます。
          </p>
        </div>
        <div class="grid grid-cols-1 gap-4">
          {related.map((s) => (
            <RelatedStrategyCard
              href={`/strategies/${s.id}`}
              title={s.data.title}
              summary={s.data.summary}
              monthsGained={s.data.monthsGained}
              evidenceStrength={s.data.evidenceStrength}
              evidence={s.data.evidence}
            />
          ))}
        </div>
      </section>
    )
  }

  <div class="pt-10 mt-10 border-t border-line max-w-2xl">
    <a
      href="/columns"
      class="link-underline font-mono text-xs uppercase tracking-widest text-accent"
    >
      ← コラム一覧へ戻る
    </a>
  </div>
</Layout>
