---
import PageHero from "../../components/blocks/PageHero.astro";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const strategies = await getCollection("strategies");

const gradeOrder = ["全学年", "低学年", "中学年", "高学年"];
const gradeMap = new Map<string, number>();
for (const s of strategies) {
  for (const g of s.data.grades) {
    gradeMap.set(g, (gradeMap.get(g) ?? 0) + 1);
  }
}

const grades = [...gradeMap.entries()].sort(
  (a, b) => gradeOrder.indexOf(a[0]) - gradeOrder.indexOf(b[0])
);
---

<Layout title="学年から探す — EduEvidence JP">
  <PageHero kicker="Browse by grade">
    <Fragment slot="title">学年から探す</Fragment>
      <p>担当する学年で使える指導法を見つけられます。</p>
  </PageHero>

  <section class="pb-24">
    <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-4">
      {
        grades.map(([grade, count]) => (
          <a
            href={`/grades/${encodeURIComponent(grade)}`}
            class="group block border border-line rounded-xl p-6 hover:border-accent hover:bg-card text-center space-y-2 motion-safe:transition-colors motion-safe:duration-200 motion-safe:ease-out"
          >
            <div class="text-3xl font-black group-hover:text-accent motion-safe:transition">
              {grade}
            </div>
            <div class="text-xs text-sub">
              {count}件の指導法 →
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
