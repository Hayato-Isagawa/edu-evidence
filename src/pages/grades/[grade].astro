---
import { getCollection } from "astro:content";
import FacetStrategyPage from "../../components/FacetStrategyPage.astro";

export async function getStaticPaths() {
  const strategies = await getCollection("strategies");
  const gradeSet = new Set<string>();
  for (const s of strategies) {
    for (const g of s.data.grades) gradeSet.add(g);
  }
  return [...gradeSet].map((grade) => ({
    params: { grade },
    props: { grade },
  }));
}

const { grade } = Astro.props;
const allStrategies = await getCollection("strategies");
const strategies = allStrategies
  .filter((s) => s.data.grades.includes(grade))
  .sort((a, b) => b.data.monthsGained - a.data.monthsGained);
---

<FacetStrategyPage kind="grade" value={grade} strategies={strategies} />
