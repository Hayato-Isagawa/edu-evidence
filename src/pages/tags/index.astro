---
import PageHero from "../../components/blocks/PageHero.astro";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const strategies = await getCollection("strategies");
const columns = await getCollection("columns");

const tagMap = new Map<string, number>();
for (const s of strategies) {
  for (const tag of s.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
  }
}
for (const c of columns) {
  for (const tag of c.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
  }
}

const tags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]);
---

<Layout title="タグ一覧 — EduEvidence JP">
  <PageHero kicker="Tags" leadSpaced>
    <Fragment slot="title">タグ一覧</Fragment>
      <p>
        指導法とコラムを関心のあるテーマから探すことができます。
      </p>
      <p class="text-xs">{tags.length}タグ / 指導法 {strategies.length}件 / コラム {columns.length}件</p>
  </PageHero>

  <section class="pb-24">
    <div class="flex flex-wrap gap-3">
      {
        tags.map(([tag, count]) => (
          <a
            href={`/tags/${encodeURIComponent(tag)}`}
            class="group border border-line rounded-full px-4 py-2 hover:border-accent hover:bg-card motion-safe:transition-colors motion-safe:duration-200 motion-safe:ease-out"
          >
            <span class="font-bold text-sm group-hover:text-accent motion-safe:transition">
              {tag}
            </span>
            <span class="font-mono text-xs text-sub ml-2">{count}</span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
